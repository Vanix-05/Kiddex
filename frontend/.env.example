# Copy this file to .env.local if you need it. Never put an API key here:
# the frontend only talks to our own backend.

# Where the backend is. Leave empty in development: Vite passes /api to
# http://localhost:3000 by itself. For the real website, set it to the
# backend's address, for example https://api.kiddex.example
VITE_API_URL=
