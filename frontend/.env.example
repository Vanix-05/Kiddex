# Copy this file to .env.local if you need it. Never put an API key here:
# the frontend only talks to our own backend.

# Where the backend is, with no slash at the end. Leave empty in development:
# Vite passes /api to http://localhost:3000 by itself. For the real website
# (Vercel), set it to the Render address, for example https://kiddex-api.onrender.com
# It is read when the site is BUILT: after changing it, build (redeploy) again.
VITE_API_URL=
