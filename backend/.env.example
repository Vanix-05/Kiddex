# Copy this file to .env and fill in the keys. Never commit .env.
PORT=3000
FRONTEND_URL=http://localhost:5173

# Google Gemini (first choice). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (automatic backup). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# How long to wait for the first AI before using the backup (milliseconds)
AI_TIMEOUT_MS=60000

# Which AI to try first, then the backup, separated by a comma.
# An AI without a key is skipped.
AI_ORDER=gemini,groq

# TEST ONLY: to see marked questions on the Check page, set a number N and every
# Nth question without a mark gets "Not found in your lesson". Leave empty
# normally. It never works when NODE_ENV=production.
DEV_MARK_EVERY=
