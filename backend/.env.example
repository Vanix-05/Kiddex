# Copy this file to .env and fill in the keys. Never commit .env.
# On Render, PORT is set by Render itself: do not add it there.
PORT=3000

# The website address(es) allowed to call this API, separated by commas, no slash at the end.
# On Render, for example: https://kiddex.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# On the real server (Render) set NODE_ENV=production. Leave it empty on this computer.
NODE_ENV=

# Google Gemini (first choice). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (automatic backup). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# How long to wait for the first AI before using the backup (milliseconds)
AI_TIMEOUT_MS=60000

# Which AI to try first, then the backup, separated by a comma.
# An AI without a key is skipped.
AI_ORDER=gemini,groq

# TEST ONLY: to see marked questions on the Check page, set a number N and every
# Nth question without a mark gets "Not found in your lesson". Leave empty
# normally. It never works when NODE_ENV=production.
DEV_MARK_EVERY=

# From Neon: Connect button. DATABASE_URL = Connection pooling ON (has -pooler), DIRECT_URL = Connection pooling OFF.
DATABASE_URL=
DIRECT_URL=

# Signs Teacher login tokens. Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First Teacher, made by npm run db:seed
SEED_TEACHER_NAME=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
