// KIDDEX database (Neon Postgres). The addresses live in backend/.env and are
// passed in by prisma.config.ts (migrations) and src/db/prisma.ts (the server).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id                  String    @id @default(cuid())
  email               String    @unique // always saved trimmed + lowercase
  name                String // shown in the planner, e.g. "Mr. Gucci"
  passwordHash        String // bcrypt hash, never the password
  tokenVersion        Int       @default(0) // goes up when the password is reset, so old logins stop working
  failedLogins        Int       @default(0) // for the "too many wrong tries" rule
  lockedUntil         DateTime? // same
  lastLoginAt         DateTime?
  active              Boolean   @default(true) // false = turned off by an admin: can't log in, lessons kept
  passwordIsTemporary Boolean   @default(true) // true after the admin makes or resets it; false after the Teacher picks their own
  passwordNoteHidden  Boolean   @default(false) // the Teacher closed the sticky note (X)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lessons             Lesson[]
  sections            Section[]
}

// Runs the Admin page (Teacher accounts only). Not a Teacher: no lessons.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique // always saved trimmed + lowercase
  name         String
  passwordHash String // bcrypt hash, never the password
  tokenVersion Int       @default(0) // goes up when the password is reset, so old logins stop working
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Lessons and their questions ----------
// The original uploaded file is never stored: only its text (units) and counts.

enum LessonStatus {
  uploaded
  making
  ready
  failed
  approved
}

enum CardType {
  multiple_choice
  matching_pair
  fill_blank
}

enum Level {
  easy
  medium
  hard
}

enum CardStatus {
  draft
  approved
}

enum CardFlag {
  not_in_lesson
  ai_unsure
}

model Lesson {
  id                  String       @id @default(cuid())
  ownerId             String
  owner               Teacher      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  topic               String?
  subject             String?
  grade               Int?
  games               String[] // the 1 or 2 picked games
  fileName            String
  fileType            String // pdf | docx | pptx
  sizeBytes           Int
  unitLabel           String // page | slide
  unitCount           Int
  unitCountIsEstimate Boolean
  wordCount           Int
  tablesRead          Int?
  picturesSkipped     Int?
  textLevel           String // none | low | ok
  units               Json // [{ number, text }], the lesson text only
  textWasCut          Boolean      @default(false)
  status              LessonStatus @default(uploaded)
  errorCode           String?
  makingStep          String? // writing | checking | waiting
  makingStartedAt     DateTime?
  approvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  questions           Question[]
  assignments         Assignment[]
  gameRounds          GameRound[]

  @@index([ownerId, createdAt])
}

model Question {
  id          String        @id @default(cuid())
  lessonId    String
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position    Int
  type        CardType
  prompt      String
  choices     String[]
  answer      String
  subject     String
  topic       String
  grade       Int
  level       Level
  explanation String?
  sourcePage  Int?
  sourceQuote String?
  flag        CardFlag?
  flagChecked Boolean       @default(false)
  madeBy      String        @default("ai") // ai | teacher
  status      CardStatus    @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  answers     RoundAnswer[]

  @@index([lessonId, position])
}

// ---------- Sections and Students ----------
// Students have NO names in KIDDEX (Master Brief 4.1): only a School ID. Never add
// a name, email or photo column here.

model Section {
  id          String       @id @default(cuid())
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  grade       Int // 3 to 6
  name        String // 1 to 30 characters, trimmed, e.g. "Sampaguita"
  nameKey     String // the name in lowercase: one Teacher can't have "Sampaguita" and "sampaguita" in the same grade
  color       String // yellow | pink | coral (the tab color)
  icon        String // flower | tulip | rose (the tab icon)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  students    Student[]
  assignments Assignment[]

  @@unique([teacherId, grade, nameKey])
  @@index([teacherId, createdAt])
}

model Student {
  id        String  @id @default(cuid())
  schoolId  String  @unique // 8 digits, no dash, e.g. "20260144" (shown as "2026-0144")
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  // The one-time code is NOT hashed on purpose: the Teacher must be able to see it
  // again (Show button, printing login cards). It works only once and is set to
  // null when the Student makes their PIN code. 6 digits, no dash. Unique, so no
  // two Students waiting to register ever share a code.
  // The PIN code IS hashed (bcrypt, cost 12, like passwords): nobody can see it.
  oneTimeCode  String?   @unique
  codeMadeAt   DateTime?
  pinHash      String? // bcrypt hash of the 4-digit PIN code, null until the Student makes one
  tokenVersion Int       @default(0) // goes up on "New code", so old Student logins stop working
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  registeredAt DateTime?
  lastLoginAt  DateTime?

  // Filled in by the Student's first-time setup (st-3).
  avatar             String?
  buddy              String?
  buddyName          String?
  look               Json?
  seenIntroClip      Boolean @default(false)
  seenBridgeCutscene Boolean @default(false)

  // Game progress (gp-1). The level is worked out from xp (300 XP per level), not saved.
  xp          Int     @default(0) // all XP ever earned
  stars       Int     @default(0)
  streakDays  Int     @default(0)
  lastPlayDay String? // the Philippine calendar day of the last saved round, e.g. "2026-11-23"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topicLevels TopicLevel[]
  gameRounds  GameRound[]

  @@index([sectionId, schoolId])
}

// ---------- Assignments (review packs) ----------
// A Teacher gives an approved lesson to a section as a review pack. Assigning the
// same lesson to the same section again updates it (unique lessonId + sectionId).

model Assignment {
  id        String      @id @default(cuid())
  lessonId  String
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String // the pack name, 1 to 60 characters
  games     String[] // 1 to 3 of quiz-show | match-up | fill-blank
  dueDate   DateTime? // the date only, saved as noon Philippine time (04:00 UTC) so it never slips a day
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  rounds    GameRound[]

  @@unique([lessonId, sectionId])
  @@index([sectionId, createdAt])
}

// ---------- Game rounds and progress (gp-1) ----------
// What a Student played, saved by POST /api/student/rounds. The backend works out
// XP, stars, the streak and the level (src/games/), never the browser.
// These tables are what step 8 (show the adaptive engine) and step 9 (Teacher
// reports: mastery per topic, weakest topics, completion) will read. Those are
// not built yet. Still no Student names anywhere.

// The difficulty engine's memory: one level per Student per topic. The engine is
// rule-based, not AI (src/games/difficulty.ts).
model TopicLevel {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicKey  String // the topic, trimmed and lowercase
  topic     String // as shown
  level     Level    @default(easy)
  updatedAt DateTime @updatedAt

  @@unique([studentId, topicKey])
}

// One finished round of one game.
model GameRound {
  id               String        @id @default(cuid())
  clientRoundId    String        @unique // made by the browser when the round starts: the same round is never saved twice
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assignmentId     String?
  assignment       Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  game             String // quiz-show | match-up | fill-blank
  topic            String
  startLevel       Level
  endLevel         Level
  change           String // up | down | keep
  reason           String // e.g. "7 of 8 right (88%)"
  right            Int // right answers, helped ones included
  helpedRight      Int
  total            Int
  helpsUsed        Int
  xp               Int // XP this round gave
  stars            Int // 1 to 3, the round's stars as shown on Results
  starsEarned      Int // stars actually added (only what beats this Student's best earlier round)
  countsForMission Boolean // true only for the first finished round of this game in this assignment
  startedAt        DateTime
  endedAt          DateTime
  createdAt        DateTime      @default(now())
  answers          RoundAnswer[]

  @@index([studentId, lessonId, game])
  @@index([assignmentId])
}

// One answer inside a round.
model RoundAnswer {
  id         String    @id @default(cuid())
  roundId    String
  round      GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  questionId String? // becomes null if the Teacher deletes the question later: the record stays
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  position   Int // 0, 1, 2… in the order played
  level      Level // copied from the question when saved
  right      Boolean
  tries      Int
  ms         Int
  helped     Boolean

  @@index([questionId])
}
