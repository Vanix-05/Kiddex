diff --git a/frontend/src/games/allGames/AllGamesPage.module.css b/frontend/src/games/allGames/AllGamesPage.module.css
index dea8e19..72cdd82 100644
--- a/frontend/src/games/allGames/AllGamesPage.module.css
+++ b/frontend/src/games/allGames/AllGamesPage.module.css
@@ -771,9 +771,240 @@
 
 /* Phone held sideways: "Play again" is at least 44px tall to tap (the
    negative margins give the height back, so the card doesn't move). */
+/*
+ * Phones held sideways: a slim mission strip (lesson on top, its games in one
+ * row of small tiles) and 4 smaller cards per row, so the other games show
+ * on the first screen too. Same colors, borders and glow as the laptop.
+ */
 @media (orientation: landscape) and (max-height: 500px) {
+  .top {
+    padding: 10px 16px 0;
+  }
+
+  .lobby,
+  .stars {
+    height: 44px;
+    border-radius: 14px;
+    box-shadow: 0 4px 0 var(--card-shadow);
+    font-size: 17px;
+  }
+
+  .lobby {
+    gap: 8px;
+    padding: 0 16px 0 6px;
+  }
+
+  .lobbyIcon {
+    width: 28px;
+    height: 28px;
+  }
+
+  .stars {
+    padding: 0 14px 0 12px;
+  }
+
+  .main {
+    margin-top: 14px;
+    padding: 0 16px;
+  }
+
+  .mission {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 10px;
+    padding: 10px 12px 12px 16px;
+    border-width: 4px;
+    border-radius: 20px;
+    box-shadow:
+      0 0 0 5px var(--orange-glow),
+      0 6px 14px rgba(240, 160, 80, 0.2);
+  }
+
+  /* Tag and lesson name on one line, the details on the next. */
+  .missionInfo {
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr);
+    align-items: center;
+    column-gap: 10px;
+  }
+
+  .from {
+    padding: 2px 9px 2px 7px;
+    border-width: 2px;
+    border-radius: 8px;
+    font-size: 14px;
+  }
+
+  .missionTitle {
+    margin: 0;
+    overflow: hidden;
+    font-size: 21px;
+    white-space: nowrap;
+    text-overflow: ellipsis;
+  }
+
+  .missionMeta,
+  .missionCount {
+    display: inline-flex;
+    grid-column: 1 / -1;
+    margin-top: 4px;
+    font-size: 14px;
+  }
+
+  .missionMeta {
+    grid-row: 2;
+    justify-self: start;
+  }
+
+  /* The count sits at the end of the details line. */
+  .missionCount {
+    grid-row: 2;
+    justify-self: end;
+    gap: 8px;
+  }
+
+  .missionGames {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 12px;
+  }
+
+  .mGame {
+    grid-template-columns: clamp(56px, 8.5vw, 76px) minmax(0, 1fr);
+    gap: 8px;
+    min-height: 0;
+    padding: 6px 8px 6px 6px;
+    border-radius: 14px;
+    box-shadow: 0 4px 0 var(--card-shadow);
+  }
+
+  .mGameNext {
+    box-shadow:
+      0 0 0 4px var(--orange-glow),
+      0 4px 0 var(--card-shadow);
+  }
+
+  .mThumb {
+    border-width: 2px;
+    border-radius: 9px;
+  }
+
+  .mBody {
+    flex-direction: row;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 4px 8px;
+  }
+
+  .mName {
+    flex-basis: 100%;
+    font-size: 16px;
+  }
+
+  /* A done game: a green check by its name instead of the Done pill, so the tile stays one size. */
+  .mBody:has(.again) .mName::before {
+    content: '✓ ';
+    color: var(--color-game-right-pill);
+  }
+
+  .donePill {
+    display: none;
+  }
+
+  /* The thumbnail and the name already say what the game is. */
+  .mLine {
+    display: none;
+  }
+
+  .play {
+    gap: 6px;
+    min-height: 40px;
+    margin: 0;
+    padding: 0 14px 0 11px;
+    border-radius: 12px;
+    box-shadow: 0 4px 0 var(--orange-edge);
+    font-size: 17px;
+  }
+
+  .play svg {
+    width: 15px;
+    height: 15px;
+  }
+
   .again {
+    min-height: 40px;
+    margin: -4px 0;
+    font-size: 15px;
+  }
+
+  .pickHead {
+    flex-direction: row;
+    align-items: center;
+    margin: 16px 0 12px;
+  }
+
+  .pickTitle {
+    font-size: 21px;
+  }
+
+  .lessonPill {
     min-height: 44px;
-    margin: -6px 0;
+    font-size: 14px;
+  }
+
+  .grid {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    gap: 14px 12px;
+  }
+
+  .card {
+    padding: 6px 6px 9px;
+    border-radius: 16px;
+    box-shadow: 0 4px 0 var(--card-shadow);
+  }
+
+  .thumb {
+    border-width: 2px;
+    border-radius: 10px;
+  }
+
+  .tag {
+    top: -11px;
+    right: 10px;
+    padding: 1px 8px 1px 6px;
+    border-width: 2px;
+    border-radius: 8px;
+    font-size: 13px;
+  }
+
+  .cardName {
+    margin: 6px 4px 0;
+    font-size: 16px;
+  }
+
+  .cardFoot {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 2px;
+    margin: 2px 4px 0;
+  }
+
+  .cardLine {
+    font-size: 13px;
+  }
+
+  .soon {
+    min-height: 0;
+    padding: 10px;
+    border-radius: 16px;
+    font-size: 13px;
+  }
+
+  .soon b {
+    font-size: 16px;
+  }
+
+  .soonPlus {
+    width: 34px;
+    height: 34px;
   }
 }
